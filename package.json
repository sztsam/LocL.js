{
  "name": "locl-js",
  "version": "2.4.0",
  "description": "Ultra-fast, lightweight TypeScript internationalization (i18n) library with React bindings, React Server Components (RSC) support, and drop-in i18next compatibility.",
  "license": "MIT",
  "author": "Sztrida Sámuel <sztsam@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./detector": {
      "import": {
        "types": "./dist/detector/index.d.ts",
        "default": "./dist/detector/index.js"
      },
      "require": {
        "types": "./dist/detector/index.d.cts",
        "default": "./dist/detector/index.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli/index.d.ts",
        "default": "./dist/cli/index.js"
      },
      "require": {
        "types": "./dist/cli/index.d.cts",
        "default": "./dist/cli/index.cjs"
      }
    }
  },
  "bin": {
    "locl": "./bin/locl.js"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sztsam/LocL.js.git"
  },
  "homepage": "https://github.com/sztsam/LocL.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest --coverage",
    "i18n:extract": "locl extract",
    "i18n:check": "locl check",
    "i18n:status": "locl status",
    "i18n:compile": "locl compile"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "typescript",
    "type-safe",
    "language",
    "plurals",
    "ordinal",
    "detector",
    "middleware",
    "formatting",
    "modular"
  ]
}
