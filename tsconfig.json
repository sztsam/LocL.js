{
  "compilerOptions": {
    "target": "es2020",
    "module": "nodenext",
    "types": ["node"],
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}